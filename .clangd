CompileFlags:
  Add:
    - "-I/Users/byeongjee/llvm-project/llvm/include"
    - "-I/Users/byeongjee/llvm-project/build/include"
    - "-std=c++17"
  Remove:
    # Remove flags that clangd doesn't understand
    - "-fno-lifetime-dse"

---
# passes/runtime/ sources are built by the ckpt toolchain (msp430-elf-gcc for
# device runtimes, native clang for the trace/profiling/mock runtimes) and
# have no compile_commands.json entries, so clangd analyzes them with host
# flags and emits bogus diagnostics (missing msp430.h, invalid section
# attributes, reserved-identifier warnings for intentional runtime symbols).
# Suppress all diagnostics there; these files are validated by the real
# cross-compilation in the test and benchmark pipelines.
If:
  PathMatch: passes/runtime/.*
Diagnostics:
  Suppress: ['*']
  ClangTidy:
    Remove: ['*']
